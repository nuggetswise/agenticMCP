{
  "name": "tg-retail-demo-mcp",
  "version": "0.4.4",
  "private": true,
  "description": "One Ashby and Northfield demo world behind every TG for Retail prototype: X12 files, a derived database, and a read-only MCP and REST server. All data is fictional.",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "node --no-warnings world/build.js && node --no-warnings scripts/openapi.js && node --no-warnings scripts/check.js",
    "world": "node --no-warnings world/build.js",
    "check": "node --no-warnings scripts/check.js",
    "validate": "node --no-warnings scripts/validate-x12.js",
    "openapi": "node --no-warnings scripts/openapi.js",
    "contract": "node --no-warnings scripts/contract.js",
    "smoke": "node --no-warnings scripts/smoke.js",
    "names": "node --no-warnings scripts/no-agent-sweep.mjs",
    "aviator-test": "node --no-warnings scripts/aviator-test.mjs",
    "start": "node --no-warnings src/server.js",
    "scout": "node --no-warnings scripts/scout-test.mjs",
    "watch": "node --no-warnings scripts/watch-test.mjs",
    "match": "node --no-warnings scripts/match-test.mjs",
    "kit-check": "node --no-warnings scripts/kit-check.mjs",
    "kit-tokens": "node --no-warnings scripts/kit-tokens.mjs --check",
    "runtime": "node --no-warnings scripts/runtime-test.mjs",
    "pages": "node --no-warnings scripts/pages.mjs",
    "hosted": "node --no-warnings scripts/hosted-test.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "express": "5.2.1",
    "zod": "3.25.76",
    "zod-to-json-schema": "3.25.2"
  }
}
