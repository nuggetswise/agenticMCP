{
  "name": "tg-retail-demo-mcp",
  "version": "0.1.0",
  "private": true,
  "description": "Read-only MCP server and seeded demo database for TG for Retail prototypes. All data is fictional.",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "node --no-warnings data/seed.js && node --no-warnings scripts/check.js",
    "check": "node --no-warnings scripts/check.js",
    "start": "node --no-warnings src/server.js",
    "smoke": "node --no-warnings scripts/smoke.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "express": "5.2.1",
    "zod": "3.25.76"
  }
}
